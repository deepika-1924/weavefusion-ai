# IBM watsonx.ai credentials
# Leave blank to use built-in fallback stories (app works without these)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Replicate API token
# Powers TWO features when set:
#   1. Garment image generation via black-forest-labs/flux-schnell (higher quality than Pollinations)
#   2. Virtual try-on via cuuupid/idm-vton (drapes the generated garment onto the user's uploaded photo)
# Without this token the app still works: Pollinations.ai generates a garment-only image,
# and virtual try-on is silently skipped (the garment image is shown as-is).
REPLICATE_API_TOKEN=

# Image generation provider (legacy — now auto-detected from REPLICATE_API_TOKEN)
# IMAGE_PROVIDER=pollinations

# Stability AI (no longer used — replaced by Replicate flux-schnell)
# STABILITY_API_KEY=
